# API Settings
PROJECT_NAME="Cuentar API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="change-this-in-production-use-a-strong-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cuentar_db

# File Storage
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["image/jpeg", "image/png", "image/webp", "application/pdf"]

# CORS
CORS_ORIGINS=["https://cuentar.arwax.pro", "http://cuentar.arwax.pro", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

